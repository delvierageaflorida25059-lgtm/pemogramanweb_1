# ==========================================================
# Smart Restaurant Management System - Environment Variables
# ==========================================================
# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# JANGAN PERNAH commit file .env ke repository.
# ==========================================================

# ---------- Application ----------
NODE_ENV=development
PORT=3000
APP_NAME=Smart Restaurant Management
# Base URL publik yang dipakai untuk generate QR Code meja.
# Di localhost, QR hanya bisa dibuka dari perangkat yang satu jaringan.
PUBLIC_BASE_URL=http://localhost:3000

# ---------- Database ----------
# Default XAMPP: user "root" dengan password kosong.
# Ubah DB_PASSWORD di bawah ini jika password MySQL Anda berbeda.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurant_management
DB_CONNECTION_LIMIT=10

# ---------- JWT ----------
# WAJIB diganti dengan string acak panjang sebelum dipakai di produksi.
# Contoh membuat secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=ganti_dengan_secret_acak_minimal_32_karakter_panjang
JWT_REFRESH_SECRET=ganti_dengan_secret_acak_lain_minimal_32_karakter_panjang
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Security ----------
BCRYPT_SALT_ROUNDS=10
# Origins frontend yang diizinkan oleh CORS. Pisahkan dengan koma.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Rate limit global untuk seluruh endpoint API.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Rate limit khusus login (mencegah brute force).
AUTH_RATE_LIMIT_MAX=10

# ---------- Restaurant / Operational ----------
RESTAURANT_NAME=Restoran Nusantara
RESTAURANT_CURRENCY=IDR
# Pengaturan pajak & service charge dalam persen.
TAX_PERCENT=10
SERVICE_CHARGE_PERCENT=5

# ---------- Seed (hanya dipakai oleh database/seed.js) ----------
SEED_ADMIN_EMAIL=admin@restaurant.test
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Administrator
SEED_MANAGER_EMAIL=manager@restaurant.test
SEED_MANAGER_PASSWORD=Manager123!
SEED_CASHIER_EMAIL=cashier@restaurant.test
SEED_CASHIER_PASSWORD=Cashier123!
SEED_KITCHEN_EMAIL=kitchen@restaurant.test
SEED_KITCHEN_PASSWORD=Kitchen123!